# Copy to /etc/sonni.env, then: chown root:root /etc/sonni.env && chmod 600 /etc/sonni.env
# Never commit the real file and never paste these values in a chat.
# A key dedicated to Sonni, in its own Anthropic workspace with a monthly spend limit (never Money Lab's key).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Sonni's own Telegram bot (never Money Lab's bot).
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Optional, free (fred.stlouisfed.org, account in the owner's name): adds US inflation and jobs report dates
# to Sonni's calendar and the Fed funds, 10-year yield and CPI sources. Leave empty for Fed decisions only.
# Sonni cannot read it.
FRED_API_KEY=
# Optional, free reader models (OpenAI-compatible APIs) that turn headlines and pages into observations.
# Free tier only, no billing enabled: Google AI Studio (aistudio.google.com) and Groq (console.groq.com).
# Leave empty to run without readers (headlines stay raw). Sonni cannot read these keys either.
GEMINI_API_KEY=
GROQ_API_KEY=
