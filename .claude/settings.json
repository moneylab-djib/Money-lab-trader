{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "likma hook session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "likma hook stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(.git/hooks/**)",
      "Edit(.mcp.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
