[Unit]
Description=Money Lab autonomous agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Started as root only to switch at once to MONEY_LAB_USER (dist/launch.js,
# before the runtime loads): a process that switches users is not dumpable,
# so the bot's own shell (same user) cannot read the runtime's keys through
# /proc/<pid>/environ. The launcher never runs the runtime as root.
User=root
Environment=MONEY_LAB_USER=moneylab
WorkingDirectory=/opt/money-lab
# Root-owned, mode 600: systemd reads it before starting the service, so the
# bot's own shell cannot read this file. Keys: ANTHROPIC_API_KEY,
# TELEGRAM_BOT_TOKEN, STRIPE_API_KEY, BLUESKY_APP_PASSWORD.
EnvironmentFile=/etc/money-lab.env
Environment=HOME=/home/moneylab
Environment=NPM_CONFIG_PREFIX=/home/moneylab/.npm-global
Environment=PATH=/home/moneylab/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/money-lab/dist/launch.js --run
Restart=always
RestartSec=30
# Basic hardening; the bot keeps write access to its home directory.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
